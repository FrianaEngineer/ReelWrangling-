# DuckDB input
DATABASE_PATH=/absolute/path/to/reelwrangling.duckdb
POSTER_SOURCE_QUERY=SELECT DISTINCT imdb_tt_id AS tt_id FROM your_table WHERE imdb_tt_id IS NOT NULL ORDER BY imdb_tt_id

# Output and tracking
POSTER_OUTPUT_DIR=/Users/friana/ReelWrangling/posters
POSTER_STATUS_TABLE=poster_download_status

# Runtime tuning
POSTER_BATCH_SIZE=25
POSTER_MAX_WORKERS=4
POSTER_CONNECT_TIMEOUT_SECONDS=10
POSTER_READ_TIMEOUT_SECONDS=30
POSTER_METADATA_MAX_RETRIES=4
POSTER_IMAGE_MAX_RETRIES=4
POSTER_BACKOFF_BASE_SECONDS=1
POSTER_JPEG_QUALITY=90
POSTER_MAX_EDGE_PIXELS=2500
POSTER_USER_AGENT=ReelWranglingPosterPipeline/1.0 (+local)

# IMDb API via AWS Data Exchange
IMDB_API_ENDPOINT=https://your-imdb-graphql-endpoint
IMDB_API_KEY=replace-me
IMDB_DATASET_ID=replace-me
IMDB_REVISION_ID=replace-me
IMDB_ASSET_ID=replace-me
AWS_REGION=us-east-1
IMDB_AWS_SERVICE=appsync

# Override this only if IMDb's schema requires a different query shape.
# IMDB_GRAPHQL_QUERY=query TitlePrimaryImages($ids: [ID!]!) { titles(ids: $ids) { id titleId meta { canonicalId } primaryImage { id url width height } } }
